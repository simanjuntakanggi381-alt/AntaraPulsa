# Gunakan password panjang alfanumerik. Jangan commit file deploy/.env.
POSTGRES_DB=antarapulsa
POSTGRES_USER=antarapulsa_app
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_RAHASIA
AUTH_SECURE_COOKIES=true
# Generate once with: openssl rand -hex 32 . Do not change it after users log in.
AUTH_SESSION_SECRET=GANTI_DENGAN_SECRET_ACAK_PANJANG
GOOGLE_CLIENT_ID=GANTI_DENGAN_CLIENT_ID_GOOGLE
GOOGLE_CLIENT_SECRET=GANTI_DENGAN_CLIENT_SECRET_GOOGLE
GOOGLE_REDIRECT_URL=https://antarapulsa.com/api/auth/google/callback

# Pulsa24Jam H2HR. Tetap false sampai IP server di-whitelist dan uji saldo selesai.
PULSA24JAM_H2HR_ENABLED=false
PULSA24JAM_H2HR_URL=https://api.pulsa24jam.net/v2/trx
PULSA24JAM_H2HR_API_KEY=
PULSA24JAM_H2HR_PIN=
PULSA24JAM_H2HR_CALLBACK_TOKEN=GANTI_DENGAN_TOKEN_ACAK_RAHASIA
