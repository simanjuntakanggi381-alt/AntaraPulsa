# Core application
AUTH_SECURE_COOKIES=true
AUTH_SESSION_SECRET=GENERATE_RANDOM_64_HEX
CORS_ALLOWED_ORIGIN=https://antarapulsa.com

# PostgreSQL
POSTGRES_DB=antarapulsa
POSTGRES_USER=antarapulsa
POSTGRES_PASSWORD=GENERATE_RANDOM_DATABASE_PASSWORD

# Google OAuth (leave all three empty to keep Google Login disabled safely)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://antarapulsa.com/api/auth/google/callback

# Operational accounts. Phone is the login username.
MARKETING_NAME=Marketing AntaraPulsa
MARKETING_PHONE=
MARKETING_EMAIL=
MARKETING_PASSWORD=
AGENT_NAME=Agent AntaraPulsa
AGENT_PHONE=
AGENT_EMAIL=
AGENT_PASSWORD=
OPERATOR_NAME=Operator AntaraPulsa
OPERATOR_PHONE=
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# Pulsa24Jam H2HR (leave ENABLED=false until URL, API key and PIN are valid)
PULSA24JAM_H2HR_ENABLED=false
PULSA24JAM_H2HR_URL=https://api.pulsa24jam.net/v2/trx
PULSA24JAM_H2HR_API_KEY=
PULSA24JAM_H2HR_PIN=
PULSA24JAM_H2HR_CALLBACK_TOKEN=GENERATE_RANDOM_CALLBACK_TOKEN
