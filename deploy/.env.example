# Gunakan password panjang alfanumerik. Jangan commit file deploy/.env.
POSTGRES_DB=antarapulsa
POSTGRES_USER=antarapulsa_app
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_RAHASIA
AUTH_SECURE_COOKIES=true
GOOGLE_CLIENT_ID=GANTI_DENGAN_CLIENT_ID_GOOGLE
GOOGLE_CLIENT_SECRET=GANTI_DENGAN_CLIENT_SECRET_GOOGLE
GOOGLE_REDIRECT_URL=https://antarapulsa.com/api/auth/google/callback
